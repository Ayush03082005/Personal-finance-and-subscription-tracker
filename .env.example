# ── Server Configuration ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database Connection ───────────────────────────────────────────────────
# MongoDB Atlas Connection URI (defaults to in-memory DB if omitted/unreachable)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_finance?retryWrites=true&w=majority

# ── JWT Authentication ────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_generate_with_crypto
JWT_EXPIRES_IN=7d

# ── Production URLs (CORS) ────────────────────────────────────────────────
# In production on Render, set this to your deployed Vercel frontend URL:
# CLIENT_URL=https://your-project.vercel.app
CLIENT_URL=http://localhost:5173

# ── Frontend Environment Variable (Set in Vercel Dashboard) ───────────────
# VITE_API_URL=https://your-backend.onrender.com
